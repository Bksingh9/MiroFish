# my-aios environment template
# Copy to .env and fill in. NEVER commit .env.

# Trading mode: dry_run | paper | live
# - dry_run: no API calls, dummy data only (use for development)
# - paper:   Alpaca paper account (default once keys are set)
# - live:    real money. Forbidden until GUARDRAILS §1 is satisfied.
TRADING_MODE=dry_run

# Alpaca (https://alpaca.markets/)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Notifications (use ONE of these)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Watchlist file (relative to my-aios root)
WATCHLIST_PATH=memory/watchlist.md

# Operator handle (for HALT / FLATTEN auth)
OPERATOR_HANDLE=
