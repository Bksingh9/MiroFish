# Copy to .env and fill in. .env is gitignored — never commit secrets.

# --- Anthropic API ---
ANTHROPIC_API_KEY=

# --- Operator identity ---
OPERATOR_EMAIL=dealmemory.ops@gmail.com
OPERATOR_NAME=

# --- Google Workspace (OAuth desktop client) ---
# After OAuth flow, token saves to config/google_token.json
GOOGLE_OAUTH_CLIENT_PATH=config/google_oauth_client.json
GOOGLE_TOKEN_PATH=config/google_token.json

# --- Google Sheets (Operations DB) ---
# Sheet ID is the long string in the sheet URL after /d/
OPS_SHEET_ID=

# --- Optional: Slack webhook for briefing delivery (instead of email-to-self) ---
SLACK_WEBHOOK_URL=
